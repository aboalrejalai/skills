{
  // Assets-only Worker: no `main`, no server code. Everything is served from ./dist
  // (Astro's static output). Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match the Worker name in the Cloudflare dashboard (Workers Builds fails otherwise).
  "name": "aboalrejal-skills",
  "compatibility_date": "2026-10-15",

  "assets": {
    "directory": "./dist",
    // Serve dist/404.html (with a 404 status) for any path that has no asset.
    "not_found_handling": "404-page",
    // /skills/x -> 307 /skills/x/ (matches Astro trailingSlash: 'always' + build.format: 'directory').
    "html_handling": "auto-trailing-slash"
  },

  // <name>.<subdomain>.workers.dev stays on so the first deploy is reachable before a custom domain exists.
  "workers_dev": true,
  // Per-version preview URLs (<version>-aboalrejal-skills.<subdomain>.workers.dev) for PR branches in Workers Builds.
  "preview_urls": true,

  // Workers Logs in the dashboard. Valid for assets-only Workers (schema-checked), but with no
  // Worker code there is little to log; it is here so logs work if a `main` is ever added.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
