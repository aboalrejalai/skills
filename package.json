    "astro": "^7.4.0",
    "fflate": "^0.8.3",
    "marked": "^18.1.1",
    "sanitize-html": "^2.18.1",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
