---
// Home page = the catalog. Every card is server-rendered; src/scripts/home-search.ts only toggles
// `hidden` on [data-item] cards from the query + filters and keeps ?q=&tag=&cat=&src= in the URL.
import { Hammer, Layers, Library, RotateCcw, Search, SearchX, Star, ThumbsUp, Wrench } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { container } from '../layout/container';
import { getCatalog } from '../../lib/catalog';
import { CATEGORIES } from '../../lib/types';
import type { Lang } from '../../lib/types';
import { CATEGORY_LABELS, localePath, TAG_LABELS } from '../../i18n';
import { fill, homeStrings } from '../../i18n/strings/home';
import { CATEGORY_ICONS, TAG_ORDER, countByCategory, countByTag, orderedItems, searchText } from './catalog-view';
import CollectionCard from './CollectionCard.astro';
import FilterPill from './FilterPill.astro';
import KpiCard from './KpiCard.astro';
import SkillCard from './SkillCard.astro';
import { contentLang } from '../content-lang';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = homeStrings[lang];

const catalog = getCatalog();
const items = orderedItems(catalog);
const total = items.length;
const tagCounts = countByTag(items);
const categoryCounts = countByCategory(items);
const categories = CATEGORIES.filter((category) => categoryCounts.has(category));
const mineCount = items.filter((item) => item.entry.own).length;
const othersCount = total - mineCount;
const collectionSkills = catalog.collections.reduce((sum, c) => sum + c.skillCount, 0);
const favorites = items.filter((item) => item.entry.tags.includes('favorite'));

const resultsText = fill(t.results, { shown: total, total });
---

<BaseLayout lang={lang} title={t.metaTitle} description={t.metaDescription} path={localePath(lang, '/')}>
  <!-- Soft mesh wash behind the hero, full-bleed and faded out before the catalog. -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[36rem] bg-mesh mask-b-from-50%"></div>
  <div
    class:list={[container, 'py-8 sm:py-10']}
    data-home
    data-msg-results={t.results}
    data-msg-copied={t.copied}
    data-msg-copy-failed={t.copyFailed}
  >
    <header class="flex items-start gap-3">
      <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
        <Library class="size-6" />
      </div>
      <div class="min-w-0">
        <h1 class="text-2xl font-bold tracking-tight md:text-3xl">{t.title}</h1>
        <p class="mt-1 max-w-3xl text-sm text-muted-foreground md:text-base">{t.intro}</p>
      </div>
    </header>

    <div role="search" class="mt-6">
      <label for="home-search" class="sr-only">{t.searchLabel}</label>
      <div class="relative">
        <Search class="pointer-events-none absolute start-3.5 top-1/2 size-5 -translate-y-1/2 text-muted-foreground" />
        <input
          id="home-search"
          type="search"
          data-search-input
          placeholder={t.searchPlaceholder}
          autocomplete="off"
          spellcheck="false"
          enterkeyhint="search"
          aria-keyshortcuts="/"
          aria-controls="home-results"
          class="peer h-12 w-full rounded-md border border-input bg-card ps-11 pe-4 text-base shadow-e1 transition-colors placeholder:text-muted-foreground hover:border-primary/40 focus-visible:border-primary sm:pe-14"
        />
        <kbd
          aria-hidden="true"
          title={t.searchShortcut}
          class="pointer-events-none absolute end-3 top-1/2 hidden -translate-y-1/2 rounded-sm border border-border bg-muted px-2 py-0.5 text-xs text-muted-foreground peer-focus:opacity-0 peer-[:not(:placeholder-shown)]:opacity-0 sm:inline-block"
        >/</kbd>
      </div>
    </div>

    <dl class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      <KpiCard
        icon={Layers}
        label={t.kpiTotal}
        value={total}
        caption={catalog.collections.length > 0
          ? fill(t.kpiTotalCaption, { skills: collectionSkills })
          : undefined}
      />
      <KpiCard icon={Hammer} label={t.kpiMade} value={tagCounts.made} caption={fill(t.kpiCaptionOf, { total })} />
      <KpiCard icon={Wrench} label={t.kpiUse} value={tagCounts.use} caption={fill(t.kpiCaptionOf, { total })} />
      <KpiCard icon={ThumbsUp} label={t.kpiRecommend} value={tagCounts.recommend} caption={fill(t.kpiCaptionOf, { total })} />
    </dl>

    <section aria-labelledby="home-filters-title" class="mt-8 flex flex-col gap-3 rounded-xl border border-border bg-card p-3 shadow-e1 sm:p-4">
      <h2 id="home-filters-title" class="sr-only">{t.filtersLabel}</h2>

      <!-- Tag + source share one row from lg; each row scrolls sideways on phones instead of wrapping. -->
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:gap-6">
        <div role="group" aria-labelledby="home-filter-tag" class="flex min-w-0 items-center gap-3">
          <span id="home-filter-tag" class="w-14 shrink-0 text-xs font-medium text-label">{t.filterTag}</span>
          <div class="pill-row">
            <FilterPill group="tag" value="" label={t.all} count={total} active />
            {TAG_ORDER.filter((tag) => tagCounts[tag] > 0).map((tag) => (
              <FilterPill group="tag" value={tag} label={TAG_LABELS[tag][lang]} count={tagCounts[tag]} />
            ))}
          </div>
        </div>

        {mineCount > 0 && othersCount > 0 && (
          <div role="group" aria-labelledby="home-filter-src" class="flex min-w-0 items-center gap-3 lg:border-s lg:border-border/60 lg:ps-6">
            <span id="home-filter-src" class="w-14 shrink-0 text-xs font-medium text-label lg:w-auto">{t.filterSource}</span>
            <div class="pill-row">
              <FilterPill group="src" value="" label={t.all} active />
              <FilterPill group="src" value="mine" label={t.sourceMine} count={mineCount} />
              <FilterPill group="src" value="others" label={t.sourceOthers} count={othersCount} />
            </div>
          </div>
        )}
      </div>

      <div role="group" aria-labelledby="home-filter-cat" class="flex items-center gap-3 border-t border-border/60 pt-3 sm:items-start">
        <span id="home-filter-cat" class="w-14 shrink-0 text-xs font-medium text-label sm:mt-2.5">{t.filterCategory}</span>
        <div class="pill-row">
          <FilterPill group="cat" value="" label={t.allCategories} active />
          {categories.map((category) => (
            <FilterPill group="cat" value={category} label={CATEGORY_LABELS[category][lang]} count={categoryCounts.get(category)} />
          ))}
        </div>
      </div>
    </section>

    {favorites.length > 0 && (
      <section data-favorites aria-labelledby="home-favorites-title" class="mt-8">
        <div class="flex items-center gap-2">
          <Star class="size-5 text-warning" />
          <h2 id="home-favorites-title" class="text-base font-semibold">{t.favoritesTitle}</h2>
        </div>
        <p class="mt-1 text-sm text-muted-foreground">{t.favoritesIntro}</p>
        <!-- Phones: one swipeable strip that bleeds to the screen edges; sm+: the hub grid. -->
        <ul class="-mx-4 mt-3 flex snap-x snap-mandatory scroll-px-4 gap-3 overflow-x-auto px-4 pb-1 [scrollbar-width:none] sm:mx-0 sm:grid sm:snap-none sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-3">
          {favorites.map((item) => {
            const Icon = CATEGORY_ICONS[item.entry.category];
            const isSkill = item.kind === 'skill';
            const href = isSkill ? localePath(lang, `/skills/${item.entry.id}/`) : item.entry.githubUrl;
            const name = item.kind === 'skill' ? item.entry.name : item.entry.title[lang];
            return (
              <li class="w-64 shrink-0 snap-start sm:w-auto">
                <a
                  href={href}
                  {...(isSkill ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
                  class="flex h-full min-h-11 items-center gap-3 rounded-xl border border-border bg-card p-3 transition-colors hover:border-primary/40 hover:bg-primary/5"
                >
                  <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                    <Icon class="size-5" />
                  </span>
                  <span class="min-w-0 flex-1">
                    <!-- bdi, not dir=auto on the block: a Latin name must still align to the page's start edge. -->
                    <span class="block truncate text-sm font-semibold"><bdi lang={isSkill ? contentLang(name) : undefined}>{name}</bdi></span>
                    <span class="block truncate text-xs text-muted-foreground">{CATEGORY_LABELS[item.entry.category][lang]}</span>
                  </span>
                  <Star class="size-4 shrink-0 fill-current text-warning" />
                  {!isSkill && <span class="sr-only">{t.opensInNewTab}</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <section aria-labelledby="home-results-title" class="mt-8">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <h2 id="home-results-title" class="text-base font-semibold">{t.gridTitle}</h2>
        <p data-results-count role="status" aria-live="polite" aria-atomic="true" class="text-sm tabular-nums text-muted-foreground">
          {resultsText}
        </p>
        <button
          type="button"
          data-reset
          data-reset-inline
          hidden
          class="ms-auto inline-flex h-9 items-center gap-1.5 rounded-md px-2.5 text-sm font-medium text-primary transition-colors hover:bg-primary/5 pointer-coarse:h-11"
        >
          <RotateCcw class="size-4" />
          {t.resetFilters}
        </button>
      </div>

      <ul id="home-results" class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((item) =>
          item.kind === 'skill' ? (
            <SkillCard skill={item.entry} lang={lang} search={searchText(item)} />
          ) : (
            <CollectionCard collection={item.entry} lang={lang} search={searchText(item)} />
          ),
        )}
      </ul>

      <div data-empty hidden class="mt-4 flex flex-col items-center rounded-xl border border-dashed border-border bg-card px-6 py-12 text-center">
        <div class="flex size-12 items-center justify-center rounded-xl bg-muted text-muted-foreground">
          <SearchX class="size-6" />
        </div>
        <h3 class="mt-4 text-base font-semibold">{t.emptyTitle}</h3>
        <p class="mt-1 max-w-sm text-sm text-muted-foreground">{t.emptyText}</p>
        <button
          type="button"
          data-reset
          class="mt-5 inline-flex h-10 items-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary-hover pointer-coarse:h-11"
        >
          <RotateCcw class="size-4" />
          {t.resetFilters}
        </button>
      </div>
    </section>

    <div
      data-toast
      role="status"
      aria-live="polite"
      class="pointer-events-none fixed inset-x-4 bottom-4 z-50 mx-auto w-fit max-w-sm translate-y-2 rounded-lg bg-foreground px-4 py-2.5 text-sm font-medium text-background opacity-0 shadow-e4 transition-all data-[show]:translate-y-0 data-[show]:opacity-100"
    ></div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/home-search.ts';
</script>
